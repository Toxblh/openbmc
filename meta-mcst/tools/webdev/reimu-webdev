#!/bin/bash
# reimu-webdev: run the new REIMU web UI and its BMC programs from tmpfs on a
# BMC with the stock firmware, without writing anything to the flash.
#
#   reimu-webdev start [--web-only]   switch to the devkit
#   reimu-webdev stop                 back to the stock firmware
#   reimu-webdev status
#
# Unpack the devkit to a tmpfs (/tmp) and run this script from there:
#   scp reimu-webdev-*.tar.gz root@bmc:/tmp/
#   ssh root@bmc 'tar xzf /tmp/reimu-webdev-*.tar.gz -C /tmp && /tmp/reimu-webdev/reimu-webdev start'
#
# What start does (all of it is undone by stop, and by any reboot: bind
# mounts and transient units don't survive it):
#   * bind mounts the devkit's web UI over /usr/share/www and its bmcweb
#     (REIMU patches: consoles with history, read-write media, CD-ROM, CSP)
#     over /usr/bin/bmcweb, its nbd-proxy over /usr/sbin/nbd-proxy;
#   * stops tmux-logger and obmc-console (they own the platform UART; the
#     list can be replaced with REIMU_WEBDEV_STOP="unit ...") and
#     starts reimu-serial instead, with a tmux/minicom "SoL" session on its
#     pty for SSH users, as the new firmware does;
#   * starts reimu-pnsd (ПНС information) with its D-Bus policy;
#   * restarts bmcweb and checks that the web answers; if it doesn't,
#     everything is rolled back.
# --web-only replaces only the web UI files (stock bmcweb and daemons): to
# see how the UI copes with the stock firmware.

set -u
D=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
R=/run/reimu-webdev

log() { echo "reimu-webdev: $*"; }
die() { log "$*" >&2; exit 1; }

bind() # source target
{
    [ -e "$2" ] || { log "skip $2 (missing on this BMC)"; return 0; }
    mount --bind "$1" "$2" || die "can't bind $1 over $2"
    echo "$2" >> $R/mounts
}

unit_active() { systemctl is-active -q "$1"; }

web_ok()
{
    local i
    for i in $(seq 1 ${1:-30}); do
        if wget -q --no-check-certificate -O /dev/null https://127.0.0.1/ 2>/dev/null ||
           curl -sfk -o /dev/null https://127.0.0.1/ 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    return 1
}

restart_bmcweb()
{
    systemctl stop bmcweb.service 2>/dev/null
    systemctl restart bmcweb.socket 2>/dev/null || systemctl restart bmcweb.service
}

do_stop()
{
    [ -d $R ] || { log "not running"; return 0; }
    local m u
    for u in reimu-webdev-pnsd reimu-webdev-serial; do
        systemctl stop $u 2>/dev/null
        systemctl reset-failed $u 2>/dev/null
    done
    [ -f $R/tmux ] && tmux kill-session -t SoL 2>/dev/null
    # the bound binaries must not be running while they are unmounted
    systemctl stop bmcweb.service 2>/dev/null
    if [ -f $R/mounts ]; then
        tac $R/mounts | while read -r m; do umount "$m" || umount -l "$m"; done
    fi
    [ -f $R/dbus ] && { systemctl reload dbus 2>/dev/null || systemctl reload dbus-broker 2>/dev/null; }
    restart_bmcweb
    [ -f $R/stopped ] && while read -r u; do systemctl start "$u"; done < $R/stopped
    rm -rf $R
    log "stock firmware web restored"
}

do_start()
{
    local webonly=0
    [ "${1:-}" = --web-only ] && webonly=1
    [ "$(id -u)" = 0 ] || die "run as root"
    [ -x /usr/bin/bmcweb ] || die "no /usr/bin/bmcweb: is this an OpenBMC (REIMU) BMC?"
    [ -d $R ] && die "already running (reimu-webdev stop first)"
    case "$(stat -f -c %T "$D")" in
        tmpfs|ramfs) ;;
        *) log "WARNING: $D is not on tmpfs (writes go to the BMC flash); /tmp is recommended" ;;
    esac
    mkdir -p $R/etc
    : > $R/mounts
    echo "$D" > $R/dir
    trap '[ $? = 0 ] || { log "failed, rolling back"; do_stop; }' EXIT

    bind "$D/www" /usr/share/www
    if [ $webonly = 0 ]; then
        ln -sfn "$D/etc/nbd-proxy" $R/etc/nbd-proxy
        bind "$D/bin/bmcweb" /usr/bin/bmcweb
        bind "$D/bin/nbd-proxy" /usr/sbin/nbd-proxy

        # the platform UART goes to reimu-serial
        : > $R/stopped
        for u in ${REIMU_WEBDEV_STOP:-tmux-logger.service} $(systemctl list-units --plain --no-legend --state=active 'obmc-console*' 2>/dev/null | awk '{print $1}'); do
            if unit_active "$u"; then
                systemctl stop "$u" && echo "$u" >> $R/stopped
            fi
        done
        # the BMC's own port list wins (a board with more COM ports)
        conf="$D/etc/reimu-serial.conf"
        [ -f /etc/reimu-serial.conf ] && conf=/etc/reimu-serial.conf
        systemd-run -q --unit=reimu-webdev-serial -p Restart=always -p RestartSec=2 \
            "$D/bin/reimu-serial" -c "$conf"

        # D-Bus policy of reimu-pnsd: a tmpfs copy of the policy directory
        mkdir -p $R/dbus-system.d
        cp -a /etc/dbus-1/system.d/. $R/dbus-system.d/ && cp "$D"/etc/dbus/*.conf $R/dbus-system.d/
        bind $R/dbus-system.d /etc/dbus-1/system.d
        touch $R/dbus
        systemctl reload dbus 2>/dev/null || systemctl reload dbus-broker 2>/dev/null
        sleep 1
        # Type=simple: reimu-pnsd requests its bus name itself (BusName= would
        # clash with a reimu-pnsd.service unit that has the same name)
        systemd-run -q --unit=reimu-webdev-pnsd -p Restart=on-failure --setenv=REIMU_PNS_SCAN="$D/libexec/reimu-pns-scan" \
            --setenv=REIMU_PNSD="$D/bin/reimu-pnsd" "$D/bin/reimu-pnsd" ||
            log "WARNING: reimu-pnsd didn't start (ПНС page will be empty)"

        # SoL for SSH users, like the new tmux-logger
        if command -v tmux >/dev/null && command -v minicom >/dev/null; then
            for i in $(seq 1 10); do [ -e /run/reimu-serial/host.pty ] && break; sleep 0.5; done
            tmux new-session -d -s SoL minicom -D /run/reimu-serial/host.pty -c on -8 -R utf8 && touch $R/tmux
        fi
    fi

    restart_bmcweb
    if ! web_ok 40; then
        log "the web doesn't answer with the devkit; bmcweb log:"
        journalctl -u bmcweb -n 20 --no-pager 2>/dev/null
        exit 1
    fi
    trap - EXIT
    log "running $(cat "$D/VERSION")$([ $webonly = 1 ] && echo ' (web UI only)'): https://$(hostname -i 2>/dev/null | cut -d' ' -f1 || hostname)/"
    log "back to the stock firmware: $D/reimu-webdev stop (or reboot the BMC)"
}

do_status()
{
    if [ ! -d $R ]; then
        log "not running"
        return 1
    fi
    log "running $(cat "$(cat $R/dir)/VERSION") from $(cat $R/dir)"
    echo "bind mounts:"; sed 's/^/  /' $R/mounts
    echo "units:"
    for u in reimu-webdev-serial reimu-webdev-pnsd bmcweb.service; do
        printf '  %-22s %s\n' $u "$(systemctl is-active $u 2>/dev/null)"
    done
    [ -s $R/stopped ] && { echo "stopped stock units:"; sed 's/^/  /' $R/stopped; }
    echo "memory: $(du -sh "$(cat $R/dir)" | cut -f1) in $(cat $R/dir), $(free -m | awk '/^Mem/{print $7 " MiB available"}')"
}

case "${1:-}" in
    start) shift; do_start "$@" ;;
    stop) do_stop ;;
    status) do_status ;;
    *) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
