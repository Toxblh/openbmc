[Unit]
Description=REIMU host agent: inventory, health and GPU fan policy for the BMC
After=network.target
# the BMC may be down for minutes (reboot, A/B switch): keep trying
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/reimu/reimu-hostd.py run
# whatever stopped it: the GPU fan back to the driver's control
ExecStopPost=/usr/bin/python3 /usr/local/lib/reimu/reimu-hostd.py restore-auto
Restart=always
RestartSec=5
# reads /sys, /proc; writes only the amdgpu fan files; runs systemctl/modprobe
# from its allow-list
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
