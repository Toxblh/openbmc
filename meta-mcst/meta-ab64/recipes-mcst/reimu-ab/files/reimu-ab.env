# U-Boot environment for A/B (fw_setenv -s): "reimu-ab setup-env" installs it.
# reimu_tries counts boots since the last "reimu-ab boot" (mark-good); after 3
# the other slot is tried. WDT1 is armed for 300 s before bootm: a kernel or
# boot that hangs resets the BMC and counts as a failed boot.
bootcmd run reimu_ab
reimu_args console=ttyS4,115200n8 root=/dev/ram rw watchdog.open_timeout=300
reimu_ab if test -z "${reimu_tries}"; then setenv reimu_tries 0; fi; if test "${reimu_slot}" != b; then setenv reimu_slot a; fi; setexpr reimu_tries ${reimu_tries} + 1; if itest ${reimu_tries} -gt 3; then if test ${reimu_slot} = a; then setenv reimu_slot b; else setenv reimu_slot a; fi; setenv reimu_tries 1; fi; saveenv; run reimu_wdt; if test ${reimu_slot} = b; then run reimu_boot_b; run reimu_boot_a; else run reimu_boot_a; run reimu_boot_b; fi
reimu_wdt mw.l 1e785004 11e1a300; mw.l 1e785008 4755; mw.l 1e78500c 13
reimu_boot_a setenv bootargs ${reimu_args} reimu.slot=a; bootm 20100000
reimu_boot_b setenv bootargs ${reimu_args} reimu.slot=b; bootm 21c00000
reimu_slot a
reimu_tries 0
