[Unit]
Description=Rotate SoL log file
RequiresMountsFor=/var/log
After=tmux-logger.service
# the timer fires every minute, and many times at once when the clock jumps
# (set at boot): no start limit, or it ends failed
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate /etc/logrotate.d/solrotate.conf
ExecStart=/bin/gzip -kf /usr/log/current
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
