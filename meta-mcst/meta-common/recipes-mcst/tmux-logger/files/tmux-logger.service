[Unit]
Description=Serial over SSH by tmux with minicom
After=network.target network-online.target remote-fs.target reimu-serial.service
Requires=reimu-serial.service

[Service]
ExecStart=/libexec/start-tmux
ExecStop=/usr/bin/tmux kill-server
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
