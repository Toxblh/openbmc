#!/bin/bash

# The platform COM port is owned by reimu-serial (history with timestamps,
# web console, raw log in /var/log/sol.log); minicom attaches to its pty.
PTY=/run/reimu-serial/host.pty
for i in $(seq 1 50); do [ -e $PTY ] && break; sleep 0.1; done
/usr/bin/tmux new-session -d -s SoL /usr/bin/minicom -D $PTY -c on -8 -R utf8
