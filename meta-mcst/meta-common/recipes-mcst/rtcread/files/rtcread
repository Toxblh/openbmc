#!/bin/bash

# 2010-01-01 00:00 UTC (busybox date -d does not parse "Jan 1, 2010")
TIME_LIMIT=1262304000

time_is_correct()
{
    test "$1" -gt "$TIME_LIMIT"
}

time_is_incorrect()
{
    test "$1" -le "$TIME_LIMIT"
}

exit_ok()
{
    echo $@
    exit 0
}

exit_err()
{
    echo $@ 1>&2
    exit 1
}

show_rtc()
{
    echo "Time from $1 RTC:"
    hwclock -r -f $2
}

# seconds since the epoch the RTC holds (hwclock -r's text isn't one busybox
# date -d parses), 0 if unreadable
read_rtc()
{
    cat /sys/class/rtc/${1#/dev/}/since_epoch 2>/dev/null || echo 0
}

# Should return something like "/dev/rtc2", or empty string on error
instantiate_rtc()
{
    model=`echo $1 | cut -d: -f1`
    slave=`echo $1 | cut -d: -f2`
    bus=`echo $1 | cut -d: -f3`

    if [ -z "$model" -o -z "$slave" -o -z "$bus" ]
    then
        echo "Can't parse $2 RTC identification string $1." 1>&2
        return
    fi

    sysfsdir=/sys/bus/i2c/devices/i2c-${bus}/${bus}-00${slave}/rtc/
    if [ ! -d $sysfsdir ]
    then
        echo "$model 0x$slave" > /sys/bus/i2c/devices/i2c-$bus/new_device
        usleep 100000
    fi

    if [ -d $sysfsdir ]
    then
        devname=/dev/`ls $sysfsdir`
        [ -c $devname ] && echo $devname || echo "Device did not export $2 RTC to devtmpfs." 1>&2
    else
        echo "Device did not export $2 RTC to sysfs." 1>&2
    fi
}

# Should return something like "mcp7941x:6f:2", or empty string on error;
# 1Э8СВ's device trees say mcp7940x (both are rtc-ds1307 devices)
detect_rtc()
{
    for model in mcp7941x mcp7940x
    do
        r=`/libexec/find_i2c_device-$1 $model`
        [ -n "$r" ] && { echo "$r" | head -1; return; }
    done
}

set_time_from()
{
    echo "Setting system time from $1 RTC..."
    hwclock -s -f $2
}

write_time_to()
{
    [ -c $2 ] || echo "No device available." 1>&2
    echo "Writing time to $1 RTC..."
    hwclock -w -f $2 || echo "Time write failed." 1>&2
}


# Search device trees for RTC identification string
RTC_STRING_M=""
FRUID_SOURCE="platform"
RTC_STRING_P=`detect_rtc platform`
[ -f "/etc/reimu_fruid.conf" ] && . /etc/reimu_fruid.conf
[ "$FRUID_SOURCE" = "module" ] && RTC_STRING_M=`detect_rtc module`
[ -z "$RTC_STRING_P" -a -z "$RTC_STRING_M" ] && exit_ok "No onboard/on-module RTC in platform/BMC device tree defined, exitting."

# The onboard RTC is the platform's boot loader's (lintel), on a bus it uses,
# and powered with the platform: it is read only at a cold boot of the BMC
# (the PNS flash found: the platform is held in reset until allow_host_boot,
# ordered after this) of a powered platform. Off, it doesn't answer and the
# bus stalls trying; after a kexec the platform may be running (and the
# time survived the kexec anyway)
if [ "$FRUID_SOURCE" != "module" ]
then
    [ -e /dev/mtd/sys ] || exit_ok "Not a cold boot (no PNS flash): the platform may be running, its RTC is left alone."
    powered=`( . /libexec/gpio-funcs; n=\`gpio2num $GPIO_POWER_IN\` && gpioread $n && gpiounexport $n ) 2>/dev/null`
    [ "$powered" = "1" ] || exit_ok "The platform is off: its RTC doesn't answer, the time is left as it is."
fi

# Instantiate and detect corresponding devtmpfs nodes
# (the BMC's own: 1e781000.rtc, wherever the kernel puts it in /sys)
RTC_I=
for r in /sys/class/rtc/rtc*
do
    case "`readlink -f $r/device`" in */1e781000.rtc) RTC_I=/dev/${r##*/};; esac
done
[ -c "$RTC_I" ] || echo "No internal RTC detected, won't save the clock there." 1>&2
RTC_M=""
RTC_P="`instantiate_rtc $RTC_STRING_P onboard`"
# then the platform's RTC goes again: nothing may use that bus later on
# (the kernel's clock sync, a hwclock) while the platform runs
if [ -n "$RTC_STRING_P" ]
then
    rtc_slave=`echo $RTC_STRING_P | cut -d: -f2`
    rtc_bus=`echo $RTC_STRING_P | cut -d: -f3`
    trap 'echo 0x$rtc_slave > /sys/bus/i2c/devices/i2c-$rtc_bus/delete_device 2>/dev/null' EXIT
fi
[ "$FRUID_SOURCE" = "module" ] && RTC_M="`instantiate_rtc $RTC_STRING_M on-module`"

# Show date, if available
echo "Current system date:"; date
[ -c "$RTC_I" ] && show_rtc "internal" $RTC_I
[ -c "$RTC_P" ] && show_rtc "onboard" $RTC_P
[ -c "$RTC_M" ] && show_rtc "on-module" $RTC_M

# Read time from RTC
TIME_P=0; TIME_M=0
[ -c "$RTC_P" ] && TIME_P=`read_rtc $RTC_P`
[ -c "$RTC_M" ] && TIME_M=`read_rtc $RTC_M`

time_is_set=n

# Try to set time from module RTC, if it is there
[ "$FRUID_SOURCE" = "module" ] && time_is_correct $TIME_M && set_time_from on-module $RTC_M && time_is_set=y

# Try to set onboard RTC from module, if time is set
[ $time_is_set = y ] && time_is_incorrect $TIME_P && echo -n "Warning, onboard time is incorrect. " && write_time_to onboard $RTC_P

# If still no time is set, try to set it from onboard RTC, if it is there
[ $time_is_set = n ] && time_is_correct $TIME_P && set_time_from onboard $RTC_P && time_is_set=y

# Correct module RTC if needed
[ $time_is_set = y -a "$FRUID_SOURCE" = "module" ] && time_is_incorrect $TIME_M && echo -n "Warning, on-module time is incorrect. " && write_time_to on-module $RTC_M

# Save time to internal RTC
[ $time_is_set = y ] && write_time_to internal $RTC_I

# a warning, not a failed unit: NTP may still set the time
[ $time_is_set = n ] && { echo "No time is set. Correct your RTC and system time manually." 1>&2; exit 0; }

echo "Current system date:"; date; exit_ok "Succeeded."
