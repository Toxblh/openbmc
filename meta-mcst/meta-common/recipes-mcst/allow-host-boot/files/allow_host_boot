#!/bin/sh

TINYSPI="no"
. /libexec/gpio-funcs
[ "`detect_tinyspi`" = "yes" ] && TINYSPI="yes"
echo "TinySPI detected: $TINYSPI"
echo "TINYSPI=$TINYSPI" > /var/volatile/reimu.conf
[ "$TINYSPI" = "yes" ] && modprobe tinyspi

echo "Releasing platform RESET"
spigpio=`gpio2num $GPIO_SPI_CONNECT`
rstgpio=`gpio2num $GPIO_RST_BTN`
gpiowrite $spigpio 0
gpiorelease $rstgpio

. /etc/auto_power_on
echo "Auto power on is $AUTO_POWER_ON"
[ "$AUTO_POWER_ON" = "off" ] && exit
[ "$AUTO_POWER_ON" = "on" ] && powerstate=1

if [ "$AUTO_POWER_ON" = "auto" ]
then
    powerstate=0
    psfile="/var/lib/reimu/last_power_state"
    [ -f "$psfile" ] && powerstate=`cat $psfile` || echo "Warning: can't read $psfile, interpreting this as if power was off"
    echo "Last power state: $powerstate"
fi

if [ "$powerstate" -eq 1 ]
then
    if [ "$POWER_ON_DELAY" ]
    then
        echo "Delaying power on for $POWER_ON_DELAY seconds"
        sleep $POWER_ON_DELAY
    fi
    echo "Powering on the platform"
    /usr/bin/server_pwr_on
    rc=$?
    # 53: the PNS flash is being read or written (reimu-pns-flash holds its
    # lock): said loudly (<3>: an error in the journal), and once the lock
    # is free (at most an hour) once more, in the background (the boot goes
    # on; the unit stays active meanwhile)
    if [ $rc = 53 ]
    then
        echo "<3>Power on REFUSED: the PNS flash is being read or written; once more when it is done"
        (
            i=0
            until flock -n /run/reimu-pns/lock true
            do
                i=$((i + 1))
                [ $i -gt 1800 ] && { echo "<3>The PNS flash still busy after an hour: the platform stays off"; exit 1; }
                sleep 2
            done
            echo "Powering on the platform (the PNS flash is free now)"
            /usr/bin/server_pwr_on
            rc=$?
            [ $rc = 0 ] || echo "<3>Power on failed again: server_pwr_on returned $rc, the platform stays off"
        ) &
    elif [ $rc != 0 ]
    then
        echo "<3>Power on failed: server_pwr_on returned $rc"
    fi
fi
