#!/bin/sh
# reimu-hid-watch: brings the KVM keyboard and mouse back when the host,
# powered and running, has not enumerated them: ONE reset of the virtual hub
# (the aspeed_vhub driver unbound and bound: the host sees the hub unplugged
# and plugged in again) per host power-on, never more.
#
# Why: once the host has suspended the BMC's hub (USB autosuspend while no
# gadget was on it) a gadget connecting later does not wake it, and the
# keyboard and mouse stay invisible to the host until it resumes the hub (see
# reimu-host.sh's udev rule). Nothing in the firmware unbinds obmc_hid in
# normal operation; this is the way back for when it happened anyway.
#
# Whether the host has the gadget, either of:
#   - the port's UDC state "not attached": the port was (re)made (a boot, a
#     kexec, a vhub reset) and the host has never configured the gadget since;
#   - reimu-kvm's "usboff", the seconds since the host's configuration
#     of the keyboard went away (f_hid answers ESHUTDOWN until the host
#     configures it again): the state stays "configured" across an unbind and
#     bind of the gadget (only a bus reset changes it). Read from its file
#     /run/reimu-kvm/usboff (since when, uptime s; absent: the host has it),
#     so that a poll runs no command; no /run/reimu-kvm (an older reimu-kvm):
#     its Status over D-Bus.
#
# The host on: as reimu-fand judges it: Host CurrentHostState (reimupwr sets
# it from GPIO_POWER_IN) anything but Off; Off or unreadable: reimu-fand's own
# verdict (reimu-fand --status "host": it probes the platform's I2C devices).
# Chassis CurrentPowerState can say Off with the host running.
#
# Rules (every POLL seconds):
#   - the host powered on for GRACE seconds and
#     obmc_hid bound to a vhub port, and the host hasn't had the keyboard for
#     GRACE seconds: the vhub is reset, once;
#   - not while a virtual media gadget is bound (a reset drops the disk the
#     host may be booting from), not again until the host is powered off and
#     on (no repeated rebinds while the host boots: its firmware may take its
#     time before it starts USB).
#
# The reset: unbind and bind aspeed_vhub (the host sees the hub unplugged and
# plugged in again), then obmc_hid's UDC bound again (BIND, or the MODE of
# "reimu-hid-watch reset MODE"):
#   address  (default) once the host has addressed the hub (AST_VHUB_CONF != 0:
#            the high-speed handshake is over), polled every 20 ms
#   udc      as soon as the port is back (/sys/class/udc/<port>), before that
#   delay:N  N ms after the driver bind
# On the board (2026-10-24/25): 2 s after the bind: an empty hub, suspended at
# once; within 20 ms ("udc"): the keyboard seen, but the hub at full speed;
# "address": high speed, but the host's port scan saw no connection and
# suspended the hub. Each reset logs a trace (uptime seconds) of the bind,
# the port, the hub address and speed, the UDC state for TRACE seconds, so
# one try tells which works. The real answer is on the host: power/control
# "on" for the hub (1d6b:0107), so it is never suspended.
#
#   reimu-hid-watch               the watcher (reimu-hid-watch.service)
#   reimu-hid-watch reset [MODE]  one reset now (not while a disk is in use)
ROOT=${ROOT:-}                  # tests: a fake /sys
POLL=${POLL:-5}
GRACE=${GRACE:-15}
VHUB=${VHUB:-1e6a0000.usb-vhub}
G=$ROOT/sys/kernel/config/usb_gadget
DRV=$ROOT/sys/bus/platform/drivers/${VHUB_DRIVER:-aspeed_vhub}
HOST_ON=${HOST_ON:-host_on}     # tests: a command saying whether the host is on
USBOFF=${USBOFF:-}              # tests: a command printing reimu-kvm's "usboff"
KVM_RUN=${KVM_RUN:-$ROOT/run/reimu-kvm}
DEVMEM=${DEVMEM:-devmem}        # tests: a fake register read
REG_CONF=0x1E6A0004             # AST_VHUB_CONF: the hub's USB address
REG_USBSTS=0x1E6A0024           # AST_VHUB_USBSTS: bit 27 high speed
BIND=address TRACE=5
[ -r $ROOT/etc/default/reimu-hid-watch ] && . $ROOT/etc/default/reimu-hid-watch

log() { echo "reimu-hid-watch: $*"; }
tlog() { echo "reimu-hid-watch: $(cut -d' ' -f1 /proc/uptime) $*"; }

host_on() {
    case "$(busctl get-property xyz.openbmc_project.State.Host /xyz/openbmc_project/state/host0 \
            xyz.openbmc_project.State.Host CurrentHostState 2>/dev/null)" in
        *HostState.Off\"|"") ;;
        *HostState.*) return 0 ;;
    esac
    case "$(reimu-fand --status 2>/dev/null)" in
        *'"host":"on"'*|*'"host":"unknown"'*|*'"host":"starting"'*) return 0 ;;
    esac
    return 1
}

# $t: uptime, whole seconds (a builtin read: no command per poll)
uptime_t() { read -r t _ < /proc/uptime; t=${t%.*}; }

usb_off() {
    busctl call xyz.openbmc_project.Reimu.Kvm /xyz/openbmc_project/reimu/kvm \
        xyz.openbmc_project.Reimu.Kvm Status 2>/dev/null | sed -n 's/.*\\"usboff\\":\([0-9]*\).*/\1/p'
}

# $off: reimu-kvm's "usboff" at uptime $t
usb_off_now() {
    if [ -n "$USBOFF" ]; then
        off=$($USBOFF)
    elif [ -d "$KVM_RUN" ]; then
        since=
        { read -r since < "$KVM_RUN/usboff"; } 2>/dev/null
        off=0
        case $since in ''|*[!0-9]*) ;; *) off=$((t - since)); [ $off -ge 0 ] || off=0 ;; esac
    else
        off=$(usb_off)
    fi
}

# a disk the host may be using: the virtual media (jsnbd's mass-storage0/1)
# and the agent installer's disk (reimu-agent-disk: reimu_agent)
media_bound() {
    for u in $G/mass-storage*/UDC $G/reimu_agent/UDC; do
        [ -s "$u" ] && [ -n "$(cat "$u")" ] && return 0
    done
    return 1
}

# the port, the hub's address and speed, the port's UDC state, obmc_hid's
# UDC: what changed since the last call, logged with the time
sample() {
    n_port=0
    [ -e $ROOT/sys/class/udc/$hid ] && n_port=1
    n_addr=$(( $($DEVMEM $REG_CONF 2>/dev/null || echo 0) & 0x7f ))
    n_hs=$(( ($($DEVMEM $REG_USBSTS 2>/dev/null || echo 0) >> 27) & 1 ))
    n_state=$(cat $ROOT/sys/class/udc/$hid/state 2>/dev/null)
    n_udc=$(cat $G/obmc_hid/UDC 2>/dev/null)
    [ "$n_port" = "$s_port" ] || { [ $n_port = 1 ] && tlog "port $hid back" || tlog "port $hid gone"; }
    [ "$n_addr" = "$s_addr" ] || tlog "hub address $n_addr"
    if [ $n_addr != 0 ] && [ "$n_hs/$n_addr" != "$s_hs/$s_addr" ] && [ "$n_hs" != "$s_hs" -o "$s_addr" = 0 ]; then
        [ $n_hs = 1 ] && tlog "hub at high speed" || tlog "hub at full speed (12 Mbit/s): the host took it on its USB 1.1 companion"
    fi
    [ "$n_state" = "$s_state" ] || tlog "state ${n_state:-none}"
    [ "$n_udc" = "$s_udc" ] || tlog "obmc_hid UDC ${n_udc:-none}"
    s_port=$n_port s_addr=$n_addr s_hs=$n_hs s_state=$n_state s_udc=$n_udc
}

reset_vhub() { # reason [mode]
    mode=${2:-$BIND}
    saved= hid=
    for u in $G/*/UDC; do
        [ -f "$u" ] || continue
        p=$(cat "$u")
        [ -n "$p" ] || continue
        if [ "${u%/UDC}" = $G/obmc_hid ]; then hid=$p; else saved="$saved ${u%/UDC}=$p"; fi
    done
    [ -n "$hid" ] || hid=$VHUB:p1
    log "$1: resetting the virtual hub, obmc_hid bound at '$mode' (obmc_hid=$hid$saved)"
    s_port= s_addr= s_hs= s_state= s_udc=
    sample
    tlog "unbind $VHUB"
    echo "$VHUB" > $DRV/unbind || { log "unbind failed"; return 1; }
    sleep 1
    sample
    tlog "bind $VHUB"
    echo "$VHUB" > $DRV/bind || { log "bind failed"; return 1; }
    case $mode in
        delay:*) usleep $(( ${mode#delay:} * 1000 )) ;;
        *)  i=0
            while [ $i -lt 150 ]; do
                sample
                [ $s_port = 1 ] && { [ $mode = udc ] || [ $s_addr != 0 ]; } && break
                usleep 20000
                i=$((i + 1))
            done
            [ $i = 150 ] && tlog "waited 3 s: port back $s_port, hub address $s_addr" ;;
    esac
    if [ "$(cat $G/obmc_hid/UDC 2>/dev/null)" != "$hid" ]; then
        echo "$hid" > $G/obmc_hid/UDC 2>/dev/null && tlog "obmc_hid bound to $hid" || tlog "obmc_hid: binding to $hid failed"
    else
        tlog "obmc_hid bound to $hid (by the gadget core)"
    fi
    # what the host makes of it
    i=0
    while [ $i -lt $((TRACE * 20)) ]; do
        sample
        [ "$s_state" = configured ] && [ $i -gt 10 ] && break
        usleep 50000
        i=$((i + 1))
    done
    # (the gadget core binds a gadget again by itself when its UDC comes back;
    # whatever isn't, is bound here)
    for s in $saved; do
        [ "$(cat "${s%%=*}/UDC" 2>/dev/null)" = "${s#*=}" ] && continue
        echo "${s#*=}" > "${s%%=*}/UDC" 2>/dev/null || log "${s%%=*}: binding to ${s#*=} failed"
    done
    [ $s_addr != 0 ] && [ $s_hs = 0 ] && log "the host took the hub at full speed (12 Mbit/s), not high speed"
    log "virtual hub reset, gadgets bound again (hub address $s_addr, state ${s_state:-none})"
}

if [ "${1:-}" = reset ]; then
    if media_bound; then log "virtual media is in use: no reset"; exit 1; fi
    reset_vhub "by hand" "${2:-}"
    exit $?
fi

on_since= na_since= done_this_power_on=0 media_said=
while :; do
    uptime_t
    if $HOST_ON; then
        [ -n "$on_since" ] || on_since=$t
    else
        on_since= done_this_power_on=0
    fi
    udc= state=
    { read -r udc < $G/obmc_hid/UDC; } 2>/dev/null
    [ -n "$udc" ] && { read -r state < $ROOT/sys/class/udc/$udc/state; } 2>/dev/null
    if [ -n "$udc" ] && [ "$state" = "not attached" ]; then
        [ -n "$na_since" ] || na_since=$t
    else
        na_since=
    fi
    usb_off_now
    lost=
    [ "${off:-0}" -ge $GRACE ] && lost="usboff $off s"
    [ -n "$na_since" ] && [ $((t - na_since)) -ge $GRACE ] && lost="not attached for $((t - na_since)) s"
    if [ -n "$on_since" ] && [ -n "$udc" ] && [ $done_this_power_on = 0 ] &&
       [ $((t - on_since)) -ge $GRACE ] && [ -n "$lost" ]; then
        # the one reset of this power-on is used when it is attempted, not when
        # a disk in use holds it back: then it waits until the disk is gone
        if media_bound; then
            [ -n "$media_said" ] || log "the host has not had the KVM keyboard ($lost), but virtual media is in use: no reset while it is"
            media_said=1
        else
            reset_vhub "the powered host has not had the KVM keyboard ($lost)"
            done_this_power_on=1 media_said=
        fi
    fi
    sleep $POLL
done
