[Unit]
Description=REIMU KVM: screen and HID straight to the browser (wss :8443)
After=start-ipkvm.service
# the TLS certificate is made by bmcweb on its first start: keep trying
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=xyz.openbmc_project.Reimu.Kvm
ExecStart=/usr/sbin/reimu-kvm
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
