[Unit]
Description=Get FRU ID data from Motherboard once it is powered
After=mcst-fruid.service
# pulled in by hwmon-instantiator.service (started at platform power-on,
# stopped at power-off by reimupwr), stopped with it
PartOf=hwmon-instantiator.service

[Service]
# not oneshot: a start job waiting for minutes would hold "boot finished"
# (is-system-running) back on a BMC booting with the platform on
Type=simple
Environment=FRU_SETTLE=120
ExecStart=/usr/libexec/reimu-fru power
# stopped at power-off while it waits: not a failure
SuccessExitStatus=SIGTERM
