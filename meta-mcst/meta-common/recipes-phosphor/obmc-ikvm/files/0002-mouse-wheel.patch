@@ -24,7 +24,7 @@ using namespace sdbusplus::xyz::openbmc_project::Common::File::Error;
 
 Input::Input(const std::string& kbdPath, const std::string& ptrPath) :
     pointerError(false), sendKeyboard(false), sendPointer(false),
-    keyboardFd(-1), pointerFd(-1), keyboardReport{0}, pointerReport{0},
+    keyboardFd(-1), pointerFd(-1), keyboardReport{0}, pointerReport{0}, lastButtonMask(0),
     keyboardPath(kbdPath), pointerPath(ptrPath)
 {
     if (!keyboardPath.empty())
@@ -138,6 +138,19 @@ void Input::pointerEvent(int buttonMask, int x, int y, rfbClientPtr cl)
     input->pointerReport[0] = ((buttonMask & 0x4) >> 1) |
                               ((buttonMask & 0x2) << 1) | (buttonMask & 0x1);
 
+    // VNC buttons 4/5 are the wheel up/down, 6/7 left/right: one step per
+    // press; the report fields are relative and reset once sent
+    int pressed = buttonMask & ~input->lastButtonMask;
+    input->lastButtonMask = buttonMask;
+    if (pressed & 0x08)
+        input->pointerReport[5]++;
+    if (pressed & 0x10)
+        input->pointerReport[5]--;
+    if (pressed & 0x20)
+        input->pointerReport[6]--;
+    if (pressed & 0x40)
+        input->pointerReport[6]++;
+
     if (x >= 0 && (unsigned int)x < video.getWidth())
     {
         uint16_t xx = (uint16_t)(x * (SHRT_MAX + 1) / video.getWidth());
@@ -230,6 +243,7 @@ void Input::sendReport()
     {
         writePointer(pointerReport);
 
+        pointerReport[5] = pointerReport[6] = 0;
         sendPointer = false;
     }
 }
