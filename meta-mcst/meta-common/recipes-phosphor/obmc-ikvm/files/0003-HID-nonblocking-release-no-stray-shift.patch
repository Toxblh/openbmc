+        keyboardFd = open(keyboardPath.c_str(), O_RDWR | O_CLOEXEC | O_NONBLOCK);
         if (keyboardFd < 0)
         {
             log<level::ERR>("Failed to open input device",
@@ -203,6 +206,13 @@
 {
     uint8_t wakeupReport[KEY_REPORT_LENGTH] = {0};
 
+    // only for a client looking at the screen: the video is opened again on
+    // every mode change too, and a Shift press then reaches the host's OS
+    if (!clients)
+    {
