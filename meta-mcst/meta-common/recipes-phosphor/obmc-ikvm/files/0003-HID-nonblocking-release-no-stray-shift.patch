-    {
-        log<level::ERR>("Failed to write keyboard report",
-                        entry("ERROR=%s", strerror(errno)));
+    memset(keyboardReport, 0, KEY_REPORT_LENGTH);
+    keysDown.clear();
+    pointerReport[0] = pointerReport[5] = pointerReport[6] = 0;
+    lastButtonMask = 0;
+    writeKeyboard(keyboardReport);
+    writePointer(pointerReport);
+    sendKeyboard = sendPointer = false;
+}
 
-        if (errno == ESHUTDOWN)
+bool Input::writeReport(int& fd, const std::string& path,
+                        const uint8_t* report, size_t len, bool& error,
+                        const char* what)
+{
+    if (fd < 0 && !path.empty())
+    {
+        // closed after an error (the gadget unbound and bound again: a new
+        // f_hid instance behind the same /dev/hidgN)
+        fd = open(path.c_str(), O_RDWR | O_CLOEXEC | O_NONBLOCK);
+    }
+    if (fd < 0)
+    {
+        return false;
+    }
+    ssize_t n = write(fd, report, len);
+    if (n < 0 && errno == EAGAIN)
+    {
+        // f_hid holds one report until the host polls: give it a moment
+        struct pollfd p = {fd, POLLOUT, 0};
+        if (poll(&p, 1, WRITE_WAIT_MS) > 0)
         {
-            close(keyboardFd);
-            keyboardFd = -1;
+            n = write(fd, report, len);
         }
-
-        return false;
     }
-
-    return true;
-}
-
-void Input::writePointer(const uint8_t *report)
-{
-    if (write(pointerFd, report, PTR_REPORT_LENGTH) != PTR_REPORT_LENGTH)
+    if (n != (ssize_t)len)
     {
-        if (!pointerError)
+        if (!error)
         {
-            log<level::ERR>("Failed to write pointer report",
-                            entry("ERROR=%s", strerror(errno)));
-            pointerError = true;
+            log<level::ERR>(what, entry("ERROR=%s", strerror(errno)));
+            error = true;
         }
-
-        if (errno == ESHUTDOWN)
+        if (errno != EAGAIN && errno != EINTR)
         {
-            close(pointerFd);
-            pointerFd = -1;
+            // ESHUTDOWN (unbound, host gone), ENODEV...: opened again with
+            // the next report
+            close(fd);
+            fd = -1;
         }
+        return false;
     }
-    else
-    {
-        pointerError = false;
-    }
+    error = false;
+    return true;
+}
+
+bool Input::writeKeyboard(const uint8_t *report)
+{
+    return writeReport(keyboardFd, keyboardPath, report, KEY_REPORT_LENGTH,
+                       keyboardError, "Failed to write keyboard report");
+}
+
+void Input::writePointer(const uint8_t *report)
+{
+    writeReport(pointerFd, pointerPath, report, PTR_REPORT_LENGTH,
+                pointerError, "Failed to write pointer report");
 }
 
