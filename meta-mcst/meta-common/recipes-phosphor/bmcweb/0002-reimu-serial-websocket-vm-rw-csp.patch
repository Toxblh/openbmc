diff --git a/include/reimu_serial.hpp b/include/reimu_serial.hpp
new file mode 100644
index 00000000..e42e8827
--- /dev/null
+++ b/include/reimu_serial.hpp
@@ -0,0 +1,185 @@
+#pragma once
+#include <app.hpp>
+#include <async_resp.hpp>
+#include <boost/asio/local/stream_protocol.hpp>
+#include <boost/container/flat_map.hpp>
+#include <websocket.hpp>
+
+#include <array>
+#include <memory>
+#include <string>
+
+namespace crow
+{
+namespace reimu_serial
+{
+
+// Relays a websocket to the reimu-serial daemon socket
+// /run/reimu-serial/port<N>.sock. Unlike /console0, every websocket gets its
+// own daemon connection, so each client receives the full timestamped history
+// on connect. The daemon speaks newline-delimited JSON; this relay is
+// protocol agnostic and just forwards the byte stream in both directions.
+class Relay : public std::enable_shared_from_this<Relay>
+{
+  public:
+    Relay(crow::websocket::Connection& connIn, const std::string& path) :
+        conn(connIn), sock(connIn.getIoContext()), endpoint(path)
+    {}
+
+    void start()
+    {
+        sock.async_connect(endpoint, [self(shared_from_this())](
+                                         const boost::system::error_code& ec) {
+            if (ec)
+            {
+                BMCWEB_LOG_ERROR << "reimu-serial: can't connect: " << ec;
+                self->closeConn("Serial port service is unavailable");
+                return;
+            }
+            self->connected = true;
+            self->doRead();
+            self->doWrite();
+        });
+    }
+
+    void send(const std::string& data)
+    {
+        // Don't let a misbehaving client grow the buffer without bound
+        if (inputBuffer.size() + data.size() > maxInput)
+        {
+            closeConn("Input overflow");
+            return;
+        }
+        inputBuffer += data;
+        doWrite();
+    }
+
+    void stop()
+    {
+        closed = true;
+        boost::system::error_code ec;
+        sock.close(ec);
+    }
+
+  private:
+    void closeConn(const std::string& reason)
+    {
+        if (!closed)
+        {
+            closed = true;
+            conn.close(reason);
+        }
+    }
+
+    void doRead()
+    {
+        sock.async_read_some(
+            boost::asio::buffer(outputBuffer.data(), outputBuffer.size()),
+            [self(shared_from_this())](const boost::system::error_code& ec,
+                                       std::size_t bytesRead) {
+                if (self->closed)
+                {
+                    return;
+                }
+                if (ec)
+                {
+                    BMCWEB_LOG_DEBUG << "reimu-serial: read failed: " << ec;
+                    self->closeConn("Serial port service closed connection");
+                    return;
+                }
+                self->conn.sendBinary(
+                    std::string_view(self->outputBuffer.data(), bytesRead));
+                self->doRead();
+            });
+    }
+
+    void doWrite()
+    {
+        if (!connected || doingWrite || inputBuffer.empty() || closed)
+        {
+            return;
+        }
+        doingWrite = true;
+        sock.async_write_some(
+            boost::asio::buffer(inputBuffer.data(), inputBuffer.size()),
+            [self(shared_from_this())](const boost::system::error_code& ec,
+                                       std::size_t bytesWritten) {
+                self->doingWrite = false;
+                if (self->closed)
+                {
+                    return;
+                }
+                if (ec)
+                {
+                    BMCWEB_LOG_ERROR << "reimu-serial: write failed: " << ec;
+                    self->closeConn("Error writing to serial port service");
+                    return;
+                }
+                self->inputBuffer.erase(0, bytesWritten);
+                self->doWrite();
+            });
+    }
+
+    static constexpr std::size_t maxInput = 1024 * 1024;
+
+    crow::websocket::Connection& conn;
+    boost::asio::local::stream_protocol::socket sock;
+    boost::asio::local::stream_protocol::endpoint endpoint;
+    std::array<char, 16384> outputBuffer{};
+    std::string inputBuffer;
+    bool connected = false;
+    bool doingWrite = false;
+    bool closed = false;
+};
+
+static boost::container::flat_map<crow::websocket::Connection*,
+                                  std::shared_ptr<Relay>>
+    relays;
+
+template <typename Rule>
+inline void setupRule(Rule& rule, int index)
+{
+    rule.privileges({"ConfigureComponents", "ConfigureManager"})
+        .websocket()
+        .onopen([index](crow::websocket::Connection& conn,
+                        const std::shared_ptr<bmcweb::AsyncResp>&) {
+            auto relay = std::make_shared<Relay>(
+                conn,
+                "/run/reimu-serial/port" + std::to_string(index) + ".sock");
+            relays[&conn] = relay;
+            relay->start();
+        })
+        .onclose([](crow::websocket::Connection& conn, const std::string&) {
+            auto it = relays.find(&conn);
+            if (it != relays.end())
+            {
+                it->second->stop();
+                relays.erase(it);
+            }
+        })
+        .onmessage([](crow::websocket::Connection& conn,
+                      const std::string& data, bool) {
+            auto it = relays.find(&conn);
+            if (it != relays.end())
+            {
+                it->second->send(data);
+            }
+        });
+}
+
+inline void requestRoutes(App& app)
+{
+    // Route paths must be compile time literals, so the (small) set of
+    // port indexes supported by reimu-serial is enumerated here.
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/0"), 0);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/1"), 1);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/2"), 2);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/3"), 3);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/4"), 4);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/5"), 5);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/6"), 6);
+    setupRule(BMCWEB_ROUTE(app, "/reimu/serial/7"), 7);
+}
+
+} // namespace reimu_serial
+} // namespace crow
