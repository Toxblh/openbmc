@@ -192,6 +192,12 @@ class Server
                                    [this, p](boost::system::error_code ec) {
                                        if (!ec)
                                        {
+                                           // no Nagle: the tail of a KVM frame
+                                           // must not wait for a delayed ACK
+                                           boost::system::error_code ignored;
