+static bool isIgnored(const char* name)
+{
+    const char* env = std::getenv("IGNORED_INTERFACES");
+    if (env == nullptr)
+    {
+        return false;
+    }
+    std::string list(env);
+    for (auto& c : list)
+    {
+        if (c == ',')
+        {
+            c = ' ';
+        }
+    }
+    size_t pos = 0;
+    while (pos < list.size())
+    {
+        auto end = list.find(' ', pos);
+        if (end == std::string::npos)
+        {
+            end = list.size();
+        }
+        if (end > pos && list.compare(pos, end - pos, name) == 0)
+        {
+            return true;
+        }
+        pos = end + 1;
+    }
+    return false;
+}
